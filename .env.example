# Veil Keepers — environment template
# Copy to .env and replace every "change-me" value. NEVER commit real credentials.

# --- MySQL ---
# Compose project name — must match the -p flag used when the stack was first
# started (homelab uses vk-sprint3 so existing volumes are prefixed
# vk-sprint3_mysql-data). Without this, docker compose defaults to the
# directory name and can't find the running services.
COMPOSE_PROJECT_NAME=vk-sprint3
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=veilkeepers
MYSQL_USER=veilkeepers
# NOTE: MYSQL_PASSWORD must NOT contain @ : / ? — these characters break
# DSN parsing when the password is interpolated into VK_DB_DSN.
MYSQL_PASSWORD=change-me-app

# --- API server ---
VK_PORT=8080
# Host port the API is exposed on; change if 18080 is already taken
VK_HOST_PORT=18080

# --- Backend database connection (Go sql driver DSN) ---
# VK_DB_DSN is not configurable: docker-compose.yml constructs it from
# MYSQL_USER, MYSQL_PASSWORD and MYSQL_DATABASE above.

# --- Feature flags ---
REGISTRATION_OPEN=true

# --- Attachments (Sprint 8) ---
# Directory (inside the API container) holding encrypted attachment files.
# docker-compose.yml bind-mounts ./data/attachments here. The host directory
# must be owned by 65532:65532 (the distroless nonroot uid/gid):
#   mkdir -p ./data/attachments && sudo chown -R 65532:65532 ./data/attachments
VK_ATTACHMENT_DIR=/data/attachments
# Hard cap on an upload body (ciphertext bytes). spec-1 §B.6 fixes this at
# 10 MiB; a malformed or non-positive value falls back to it.
VK_ATTACHMENT_MAX_BYTES=10485760

# --- Backup (Sprint 10) ---
# Directory where backup.sh writes timestamped backup sets (MySQL dump +
# attachment archive). Each backup contains encrypted vault data — treat
# backup files as SENSITIVE (spec.md §48). Retention policy is enforced
# by the script: daily backups kept 7 days, weekly backups kept 4 weeks.
VK_BACKUP_DIR=./backups
