<?xml version="1.0" encoding="utf-8"?>
<!--
  All user-facing copy for the Compose UI (Sprint 9, decision #4). Screens read
  these via stringResource / pluralStringResource — no hardcoded literals in
  ui/*.kt. Brand vocabulary (Vault / Secret / Keeper / Veil) is used sparingly
  and always beside a plain-language label (spec.md §28: "do not overuse
  fantasy terminology"). Punctuation-only separators (· • —) stay inline in
  code; pure search-logic labels (SearchEngine.matchSummary) are out of scope.
-->
